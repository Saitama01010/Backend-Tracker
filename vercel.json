{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "artifacts/agent-dashboard/dist/public",
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/jobs/cron",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
