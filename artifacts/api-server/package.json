{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "tsx --test src/lib/anthropic-features.test.ts src/lib/dashboard-actions.test.ts src/lib/databasePerformance.test.ts src/baseline/regression.test.ts src/security/backgroundJobs.test.ts",
    "test:baseline": "tsx --test src/baseline/regression.test.ts",
    "test:security": "tsx --test src/security/*.test.ts",
    "test:webhooks:integration": "tsx --test src/security/webhooks.integration.test.ts",
    "test:jobs:integration": "tsx --test src/security/backgroundJobs.integration.test.ts",
    "test:performance": "tsx --test src/performance/databasePerformance.integration.test.ts",
    "test:smoke": "tsx --test src/baseline/smoke.test.ts",
    "baseline:serve": "tsx src/baseline/server.ts",
    "setup-admin": "node ./scripts/setup-admin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "zod": "catalog:"
  }
}
